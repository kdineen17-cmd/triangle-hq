# ---------------- SEC EDGAR (required) ----------------
# SEC fair-access policy: identify yourself with a name and contact email.
SEC_USER_AGENT="Your Name your.email@example.com"

# ---------------- Signal definition ----------------
MIN_INSIDERS=2                 # distinct C-suite/director buyers required
CLUSTER_WINDOW_DAYS=30         # rolling window, by transaction date
MAX_MARKET_CAP_USD=2000000000  # small/mid cap ceiling ($2B)
MIN_CLUSTER_VALUE_USD=0        # optional: minimum total $ bought in the window
SKIP_UNKNOWN_MARKET_CAP=true   # drop issuers with no XBRL shares-outstanding data
POLL_SECONDS=300
DB_PATH=data/insider.db

# ---------------- Robinhood Agentic Trading ----------------
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
# Account number of the Robinhood account you enabled for agentic trading.
ROBINHOOD_ACCOUNT_NUMBER=
# OAuth tokens are written here with 0600 permissions (never commit this file).
ROBINHOOD_TOKEN_PATH=~/.config/insider-tracker/robinhood_oauth.json
OAUTH_REDIRECT_PORT=8765

# ---------------- Risk limits ----------------
DRY_RUN=true                   # true = review + log only; set false to send real orders
ORDER_TYPE=limit               # limit (whole shares, marketable limit) | market (dollar-based, fractional)
ORDER_DOLLARS=100              # target $ per approved signal
MAX_ORDER_DOLLARS=250          # hard cap per order
MAX_ORDERS_PER_DAY=3
LIMIT_BUFFER_BPS=25            # limit price = ask * (1 + 0.25%)
